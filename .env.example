# =============================================================================
# Layer 4 Agent Model Configuration
# =============================================================================

# Router Agent Model Configuration
# ---------------------------------
# Provider options: openai, anthropic, google, groq, aws, nexus, openrouter
# Default: openai
ROUTER_MODEL_PROVIDER=openai

# Model ID depends on provider:
# - openai: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# - anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# - google: gemini-1.5-pro, gemini-1.5-flash
# - groq: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b
# - aws: claude-3-5-sonnet-20241022 (Claude via AWS Bedrock)
# - nexus: anthropic/claude-sonnet-4-20250514
# - openrouter: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-exp
# Default: provider-specific (see core/models/factory.py)
ROUTER_MODEL_ID=gpt-4o-mini

# Temperature (0.0-1.0) for sampling randomness
# Lower = more deterministic, Higher = more creative
# Default: None (uses provider default)
ROUTER_MODEL_TEMPERATURE=0.1


# =============================================================================
# Model Provider API Keys
# =============================================================================
# You only need API keys for providers you plan to use

# OpenAI (required for default configuration)
OPENAI_API_KEY=sk-...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# Note: Requires 'uv add google-genai' to install optional dependency
GOOGLE_API_KEY=...

# Groq
GROQ_API_KEY=...

# OpenRouter (provides access to 100+ models from multiple providers)
# Recommended for flexibility - single API key for all models
OPENROUTER_API_KEY=sk-or-...

# AWS Bedrock (requires AWS credentials)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Nexus (multi-provider router)
NEXUS_API_KEY=...


# Planner Agent Model Configuration
# -----------------------------------
# Uses more powerful model than Router for complex reasoning
# Default: gpt-4o
PLANNER_MODEL_PROVIDER=openai
PLANNER_MODEL_ID=gpt-4o
PLANNER_MODEL_TEMPERATURE=0.2


# =============================================================================
# Narrator Agent Model Configuration
# =============================================================================
# Narrator explains strategies with evidence-based citations
# Uses faster model than Planner (gpt-4o-mini vs gpt-4o)
# Default: gpt-4o-mini
NARRATOR_MODEL_PROVIDER=openai
NARRATOR_MODEL_ID=gpt-4o-mini
NARRATOR_MODEL_TEMPERATURE=0.1


# =============================================================================
# Database Configuration (Session Management & Memory)
# =============================================================================

# PostgreSQL database URL for agent session history and memory
# All agents (Router, Planner, Narrator, Team) share the same database
#
# Format: postgresql+psycopg://user:password@host:port/database
# Default: postgresql+psycopg://ai:ai@localhost:5532/ai
#
# To start local PostgreSQL with pgvector (required for knowledge base):
#   docker run -d --name agno-postgres \
#     -e POSTGRES_USER=ai \
#     -e POSTGRES_PASSWORD=ai \
#     -e POSTGRES_DB=ai \
#     -p 5532:5432 \
#     ankane/pgvector
#
# Session Storage:
# - Team sessions stored in 'layer4_sessions' table
# - Knowledge base vectors stored in 'embeddings' table
# - User memories stored in 'user_memories' table
# - Agno auto-creates tables on first run
#
POSTGRES_DB_URL=postgresql+psycopg://ai:ai@localhost:5532/ai

# Session Management Configuration
# ---------------------------------
# These are automatically applied via core/config/agno_settings.py
# Override in code if needed for specific agents/teams
#
# - enable_session_summaries: Summarize long conversations (default: true)
# - enable_user_memories: Remember user-specific context (default: true)
# - cache_session: Cache sessions in memory for speed (default: true)
# - add_history_to_context: Include chat history (default: true)
# - num_history_runs: Number of previous runs to include (default: 10)


# =============================================================================
# Service Endpoints (Layer 3, Layer 5)
# =============================================================================

# Layer 3 - Signals Service
SIGNALS_URL=http://localhost:8082/signals

# Layer 3 - Validation Service
VALIDATE_URL=http://localhost:8081/validate

# Layer 3 - Compilation Service
COMPILE_URL=http://localhost:8081/compile

# Layer 5 - Simulation Service
L5_SIM_URL=http://localhost:7090/simulate

# ClickHouse (PIT Data)
CH_READ_URL=http://localhost:8123/query
CH_USER=default
CH_PASS=


# =============================================================================
# Observability (Layer 8)
# =============================================================================

# Langfuse (LLM observability)
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# LANGFUSE_HOST=https://cloud.langfuse.com


# =============================================================================
# Development Settings
# =============================================================================

# Enable debug logging
# DEBUG=true

# Disable guardrails (for development only - NOT for production)
# DISABLE_GUARDRAILS=false
